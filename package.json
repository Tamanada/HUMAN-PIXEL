{
  "name": "human-pixel",
  "private": true,
  "version": "1.0.0",
  "description": "HUMAN PIXEL: giant human formations. The server coordinates the event, the phone executes the experience.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:participant": "npm run dev -w @human-pixel/participant",
    "dev:console": "npm run dev -w @human-pixel/console",
    "build": "npm run build -w @human-pixel/participant && npm run build -w @human-pixel/console",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:load": "npm run load -w @human-pixel/simulator",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "node tools/simulator/src/sqlTests.mjs",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
