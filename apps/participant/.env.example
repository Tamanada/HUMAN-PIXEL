# Supabase (public values only: the anon key is safe in clients; RLS protects data)
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=
# CDN-cached public manifest. {eventId} is substituted. Leave empty to call the RPC directly (dev).
VITE_MANIFEST_URL=/m/{eventId}
# Low-latency time endpoint for clock sync. Empty = Supabase Edge Function `time`.
VITE_TIME_URL=/api/time
# Optional error tracking
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0
