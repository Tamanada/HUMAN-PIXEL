VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=
# Public participant app origin (join links and QR codes point here)
VITE_PARTICIPANT_URL=http://localhost:5173
# Base map (vector style JSON). OpenFreeMap needs no key.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional satellite raster tiles (XYZ template). Use a licensed provider in production (e.g. MapTiler).
VITE_SATELLITE_TILES=
VITE_SATELLITE_ATTRIBUTION=
# Last zoom level with real imagery at your venue (higher zooms upscale it). Default 18.
VITE_SATELLITE_MAXZOOM=18
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0
